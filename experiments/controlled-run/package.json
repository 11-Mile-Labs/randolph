{
  "name": "@randolph/controlled-run",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "lint": "oxlint --deny-warnings src test",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "test:native": "pnpm build && node dist/src/cli.js",
    "test:followup": "pnpm build && node dist/src/followup.js",
    "test:scripted": "pnpm build && node dist/src/scripted-git.js",
    "test:lifecycle": "pnpm build && node dist/src/lifecycle-probe.js"
  },
  "dependencies": {
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "oxlint": "1.82.0",
    "typescript": "7.0.2"
  }
}
